# ─── west.yml ────────────────────────────────────────────────────────────────
# Add the module next to your zmk entry.

manifest:
  remotes:
    - name: zmkfirmware
      url-base: https://github.com/zmkfirmware

    # Your fork / public repo hosting this module:
    - name: you
      url-base: https://github.com/<your-github-username>

  projects:
    - name: zmk
      remote: zmkfirmware
      revision: main        # or pin to a tag, e.g. v0.3.0
      import: app/west.yml

    - name: zmk-oled-gifs
      remote: you
      revision: main

  self:
    path: config


# ─── config/lily58.conf (or whichever keyboard) ──────────────────────────────

# Required ZMK display flags:
CONFIG_ZMK_DISPLAY=y
CONFIG_ZMK_DISPLAY_STATUS_SCREEN_CUSTOM=y

# Recommended display tuning for SSD1306 128×32:
CONFIG_LV_Z_VDB_SIZE=64
CONFIG_LV_DPI_DEF=148
CONFIG_LV_Z_BITS_PER_PIXEL=1
CONFIG_LV_COLOR_DEPTH_1=y
CONFIG_ZMK_DISPLAY_WORK_QUEUE_DEDICATED=y

# Enable the GIF module:
CONFIG_OLED_GIFS=y

# How fast frames advance (ms):
CONFIG_OLED_GIF_FRAME_PERIOD_MS=150

# Enable only the GIFs you want compiled in:
CONFIG_OLED_GIF_BLINK=y
# CONFIG_OLED_GIF_CAT=y      ← uncomment once you add a cat.c


# ─── build.yaml ──────────────────────────────────────────────────────────────
---
include:
  - board: nice_nano_v2
    shield: lily58_left oled_gifs
  - board: nice_nano_v2
    shield: lily58_right oled_gifs

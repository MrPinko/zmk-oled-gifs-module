config ZMK_OLED_GIF
    bool "ZMK OLED GIF animation"
    default n
    help
      Enable GIF frame animation on OLED displays.
      Register animations using ZMK_OLED_GIF_DEFINE() and cycle
      through them with the &gif_cyc keymap behavior.

      NOTE: disable ZMK's built-in display widgets in your .conf
      to avoid conflicts with direct display writes:
        CONFIG_ZMK_WIDGET_BATTERY_STATUS=n
        CONFIG_ZMK_WIDGET_OUTPUT_STATUS=n
        CONFIG_ZMK_WIDGET_LAYER_STATUS=n
        CONFIG_ZMK_WIDGET_WPM_STATUS=n

config ZMK_OLED_GIF_BONGO_CAT
    bool "Include bongo cat animation"
    default n
    depends on ZMK_OLED_GIF
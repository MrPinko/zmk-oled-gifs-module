# Kconfig — zmk-oled-gifs shield
# Add one CONFIG_OLED_GIF_<NAME>=y per animation you want compiled in.
# Only enabled GIFs are linked; everything else is dead-stripped.

menuconfig OLED_GIFS
    bool "OLED GIF animation module"
    default n
    depends on ZMK_DISPLAY
    help
      Renders looping frame animations on a ZMK OLED display.
      Enable individual GIFs below.

if OLED_GIFS

config OLED_GIF_FRAME_PERIOD_MS
    int "Frame period in milliseconds"
    default 150
    help
      How long each frame is shown before advancing to the next one.
      Lower = faster animation.

# ── built-in test animation ────────────────────────────────────────────────
config OLED_GIF_BLINK
    bool "Enable built-in 2-frame blink test animation"
    default n
    help
      A minimal 2-frame checkerboard blink used for hardware bring-up.
      Disable once you have a real GIF working.

# ── add your own GIFs below, one block per animation ──────────────────────
# Example:
# config OLED_GIF_CAT
#     bool "Enable cat animation"
#     default n

endif # OLED_GIFS

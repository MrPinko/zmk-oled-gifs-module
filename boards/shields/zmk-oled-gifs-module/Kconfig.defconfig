#
# Kconfig defaults for the zmk-oled-gifs-module shield.
# These are applied automatically when the shield is selected.

# ── LVGL display settings ────────────────────────────────────────────────────
config LV_Z_VDB_SIZE
    default 100

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

# ── LVGL features required by the widgets ────────────────────────────────────
# Select the LVGL widget features that our custom widgets use.
config NICE_OLED_WIDGET_STATUS
    bool
    default y if ZMK_DISPLAY
    select LV_USE_LABEL
    select LV_USE_IMG
    select LV_USE_CANVAS
    select LV_USE_ANIMIMG
    select LV_USE_ANIMATION

# ── ZMK display work queue ────────────────────────────────────────────────────
choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

# ── Custom status screen ──────────────────────────────────────────────────────
choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

# ── Memory pool for LVGL ──────────────────────────────────────────────────────
config LV_Z_MEM_POOL_SIZE
    default 4096 if ZMK_DISPLAY_STATUS_SCREEN_CUSTOM

# ── Left (central) side animation ────────────────────────────────────────────
config NICE_LEFT_ANIMATION
    bool "Enable animated GIF on central (left) side OLED"
    default n
    help
      When enabled, the central side uses lv_animimg to cycle through all
      frames defined in assets/left_image.c. When disabled, only the first
      frame is shown as a static image.

config NICE_LEFT_ANIMATION_MS
    int "Total animation duration for left side (ms)"
    default 2400
    help
      Total time in milliseconds for one full loop of the left-side animation.

# ── Right (peripheral) side animation ────────────────────────────────────────
config NICE_RIGHT_ANIMATION
    bool "Enable animated GIF on peripheral (right) side OLED"
    default y
    help
      When enabled, the peripheral side uses lv_animimg to cycle through all
      frames defined in assets/right_image.c. When disabled, only the first
      frame is shown as a static image.

config NICE_RIGHT_ANIMATION_MS
    int "Total animation duration for right side (ms)"
    default 2400
    help
      Total time in milliseconds for one full loop of the right-side animation.

# ── Display inversion ─────────────────────────────────────────────────────────
config NICE_OLED_WIDGET_INVERTED
    bool "Invert display colors (white-on-black instead of black-on-white)"
    default n